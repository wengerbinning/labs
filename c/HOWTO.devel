AC_CHECK_HEADERS([arpa/inet.h fcntl.h stdint.h sys/file.h sys/socket.h sys/time.h syslog.h unistd.h])\


AC_CHECK_HEADER_STDBOOL
AC_C_INLINE
AC_TYPE_PID_T
AC_TYPE_SIZE_T
AC_STRUCT_TIMEZONE
AC_TYPE_UID_T
AC_TYPE_UINT32_T
AC_TYPE_UINT64_T
AC_TYPE_UINT8_T


AC_FUNC_ERROR_AT_LINE
AC_FUNC_FORK
AC_FUNC_MALLOC
AC_FUNC_MKTIME
AC_CHECK_FUNCS([clock_gettime dup2 fchdir getcwd gettimeofday inet_ntoa memchr memset mkdir regcomp socket strdup strerror strstr])


