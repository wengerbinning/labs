

```shell
sudo chroot ./
```

```shell
export PATH=/usr/sbin:/sbin:/usr/bin:/bin
mount -t devtmpfs dev /dev
mount -t proc prov /proc
```




```shell
sudo pacman --root . -Sy util-linux vim git gcc
sudo pacman --root . -Sy net-tools
sudo pacman --root . -Sy make pkgconf cmake
sudo pacman --root . -Sy json-c
sudo pacman --root . -Sy lua
```


```shell
mkdir .build && cd .build
cmake ../ -DCMAKE_POLICY_VERSION_MINIMUM=3.5
make -j$(nproc)
cmake --install ./ --prefix=dst/usr
```

